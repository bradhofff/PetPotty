@page
@model PetPotty.Pages.SignupModel
@{
    ViewData["Title"] = "Create account";
}

<div class="simple-auth-page auth-signup-page">
    <div class="auth-shell">
        <aside class="auth-brand-panel" aria-label="About PackTracker">
            <a asp-page="/Index" class="auth-wordmark"><span class="auth-mark" aria-hidden="true">🐾</span> PackTracker</a>
            <div class="auth-brand-copy">
                <span class="auth-eyebrow">Welcome to the pack</span>
                <h1>Better care starts here.</h1>
                <p>Bring routines, health notes, and the people who help into one calm place.</p>
                <div class="auth-feature-list" aria-hidden="true">
                    <div><span>✓</span> Plan each pet's day</div>
                    <div><span>✓</span> Remember the important details</div>
                    <div><span>✓</span> Share care with your household</div>
                </div>
            </div>
            <p class="auth-brand-footer">A happier routine for you and your pets.</p>
        </aside>
        <div class="auth-form-panel">
            <div class="auth-form-wrap">
                <div class="auth-form-heading">
                    <span class="auth-form-eyebrow">GET STARTED</span>
                    <h2>Create your account</h2>
                    <p>A few details and you're ready to care together.</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <input asp-for="InvitationToken" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                    <p class="auth-required-note"><span class="required-marker" aria-hidden="true">*</span> Required fields</p>
                    <div class="auth-field">
                        <label asp-for="SignupName" class="form-label">Full name <span class="required-marker" aria-hidden="true">*</span></label>
                        <input asp-for="SignupName" class="form-control" autocomplete="name" placeholder="Your full name" required aria-required="true" />
                        <span asp-validation-for="SignupName" class="text-danger small"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="SignupUserName" class="form-label">Username <span class="required-marker" aria-hidden="true">*</span></label>
                        <input asp-for="SignupUserName" class="form-control" autocomplete="username" placeholder="Choose a username" aria-describedby="usernameHint" required aria-required="true" />
                        <small id="usernameHint" class="auth-hint">No spaces in your username.</small>
                        <span asp-validation-for="SignupUserName" class="text-danger small"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="SignupEmail" class="form-label">Email address <span class="required-marker" aria-hidden="true">*</span></label>
                        <input asp-for="SignupEmail" type="email" class="form-control" autocomplete="email" placeholder="you@example.com" required aria-required="true" />
                        <span asp-validation-for="SignupEmail" class="text-danger small"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="SignupPhone" class="form-label">Phone number <span class="auth-optional">Optional</span></label>
                        <input asp-for="SignupPhone" type="tel" class="form-control" autocomplete="tel" placeholder="(555) 123-4567" />
                        <span asp-validation-for="SignupPhone" class="text-danger small"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="SignupPass" class="form-label">Password <span class="required-marker" aria-hidden="true">*</span></label>
                        <div class="auth-password-wrap">
                            <input asp-for="SignupPass" type="password" class="form-control" autocomplete="new-password" placeholder="Create a password" required aria-required="true" />
                            <button type="button" class="auth-password-toggle" data-password-toggle="SignupPass" aria-label="Show password" aria-pressed="false">Show</button>
                        </div>
                        <span asp-validation-for="SignupPass" class="text-danger small"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="SignupConfirmPass" class="form-label">Confirm password <span class="required-marker" aria-hidden="true">*</span></label>
                        <div class="auth-password-wrap">
                            <input asp-for="SignupConfirmPass" type="password" class="form-control" autocomplete="new-password" placeholder="Enter your password again" aria-describedby="passMismatch" required aria-required="true" />
                            <button type="button" class="auth-password-toggle" data-password-toggle="SignupConfirmPass" aria-label="Show confirmation password" aria-pressed="false">Show</button>
                        </div>
                        <small id="passMismatch" class="text-danger d-none" aria-live="polite">Passwords do not match.</small>
                        <span asp-validation-for="SignupConfirmPass" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn auth-primary-btn w-100">Create account <span aria-hidden="true">→</span></button>
                </form>
                <p class="auth-switch">Already have an account? <a asp-page="/Login" asp-route-invitationToken="@Model.InvitationToken">Log in</a></p>
                <a asp-page="/Index" class="auth-back-link">← Back to home</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-password-toggle]').forEach(button => {
            button.addEventListener('click', () => {
                const field = document.getElementById(button.dataset.passwordToggle);
                const showing = field.type === 'password';
                field.type = showing ? 'text' : 'password';
                button.textContent = showing ? 'Hide' : 'Show';
                button.setAttribute('aria-pressed', String(showing));
                button.setAttribute('aria-label', `${showing ? 'Hide' : 'Show'} ${field.id === 'SignupPass' ? 'password' : 'confirmation password'}`);
            });
        });
        const password = document.getElementById('SignupPass');
        const confirmation = document.getElementById('SignupConfirmPass');
        const mismatch = document.getElementById('passMismatch');
        function checkPasswords() {
            const different = confirmation.value.length > 0 && password.value !== confirmation.value;
            mismatch.classList.toggle('d-none', !different);
            confirmation.setCustomValidity(different ? 'Passwords do not match.' : '');
        }
        password.addEventListener('input', checkPasswords);
        confirmation.addEventListener('input', checkPasswords);
    </script>
}
