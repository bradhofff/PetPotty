@page
@model PetPotty.Pages.PremiumComingSoonModel
@{
    ViewData["Title"] = "Premium";
}

<style>
    .premium-preview { max-width: 1020px; margin: 0 auto 4rem; color: #273142; }
    .premium-preview-hero { position: relative; overflow: hidden; border-radius: 26px; padding: clamp(2.5rem, 7vw, 5rem); background: linear-gradient(135deg, #302b46 0%, #6b3650 54%, #d96a33 100%); color: #fff; box-shadow: 0 24px 55px rgba(66, 39, 49, .17); }
    .premium-preview-hero::before, .premium-preview-hero::after { content: ""; position: absolute; border: 1px solid rgba(255,255,255,.16); border-radius: 50%; pointer-events: none; }
    .premium-preview-hero::before { width: 350px; height: 350px; right: -95px; top: -185px; }
    .premium-preview-hero::after { width: 470px; height: 470px; right: -200px; bottom: -340px; }
    .premium-preview-hero-content { position: relative; z-index: 1; max-width: 660px; }
    .premium-preview-mark { display: inline-flex; align-items: center; justify-content: center; width: 54px; height: 54px; border-radius: 17px; background: rgba(255,255,255,.18); font-size: 1.8rem; margin-bottom: 1.5rem; }
    .premium-preview-eyebrow { display: inline-block; text-transform: uppercase; letter-spacing: .15em; font-size: .73rem; font-weight: 800; color: #ffe0c5; }
    .premium-preview-hero h1 { font-size: clamp(2.35rem, 5vw, 4rem); font-weight: 800; letter-spacing: -.05em; line-height: 1.06; margin: .7rem 0 1.15rem; }
    .premium-preview-hero p { color: rgba(255,255,255,.88); font-size: 1.1rem; line-height: 1.6; margin: 0; }
    .premium-preview-section { padding: 2.6rem 0 0; }
    .premium-preview-section-heading { text-align: center; margin-bottom: 1.4rem; }
    .premium-preview-section-heading h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 750; letter-spacing: -.035em; margin-bottom: .35rem; }
    .premium-preview-section-heading p { color: #697386; margin: 0; }
    .premium-preview-price-card { height: 100%; padding: 1.8rem; border: 1px solid #e7dcd8; border-radius: 20px; background: var(--bs-body-bg); box-shadow: 0 10px 30px rgba(44, 43, 65, .06); }
    .premium-preview-price-card h3 { font-size: 1.05rem; font-weight: 750; margin: 0 0 1.5rem; }
    .premium-preview-price { font-size: clamp(2.2rem, 4vw, 2.85rem); font-weight: 800; letter-spacing: -.055em; line-height: 1; }
    .premium-preview-billing { color: #697386; font-size: .9rem; margin-top: .5rem; }
    .premium-preview-soon { display: inline-block; margin-top: 1.7rem; padding: .4rem .75rem; border-radius: 999px; background: #fff1e8; color: #a94e1c; font-size: .72rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
    .premium-preview-footer { text-align: center; color: #697386; margin-top: 1.8rem; font-size: .9rem; }
    html[data-bs-theme="dark"] .premium-preview { color: var(--bs-body-color); }
    html[data-bs-theme="dark"] .premium-preview-price-card { border-color: #54454b; }
    html[data-bs-theme="dark"] .premium-preview-section-heading p,
    html[data-bs-theme="dark"] .premium-preview-billing,
    html[data-bs-theme="dark"] .premium-preview-footer { color: #b9c1ce; }
    html[data-bs-theme="dark"] .premium-preview-soon { background: #4a2d24; color: #ffbd92; }
</style>

<div class="premium-preview">
    <section class="premium-preview-hero" aria-labelledby="premiumPreviewTitle">
        <div class="premium-preview-hero-content">
            <span class="premium-preview-mark" aria-hidden="true">🐾</span>
            <div class="premium-preview-eyebrow">PackTracker Premium</div>
            <h1 id="premiumPreviewTitle">Something lovely is coming soon.</h1>
            <p>We're getting Premium ready for you and your pets. Check back soon.</p>
        </div>
    </section>

    @if (Model.Prices.Count > 0)
    {
        <section class="premium-preview-section" aria-labelledby="premiumPreviewPrices">
            <div class="premium-preview-section-heading">
                <h2 id="premiumPreviewPrices">Premium plans</h2>
                <p>A first look at our pricing.</p>
            </div>
            <div class="row g-3">
                @foreach (var plan in Model.Prices)
                {
                    <div class="col-md-4">
                        <article class="premium-preview-price-card">
                            <h3>@plan.Name</h3>
                            <div class="premium-preview-price">@plan.PriceLabel</div>
                            <div class="premium-preview-billing">@plan.BillingLabel</div>
                            <span class="premium-preview-soon">Coming soon</span>
                        </article>
                    </div>
                }
            </div>
            <p class="premium-preview-footer">Premium isn't available to purchase yet.</p>
        </section>
    }
</div>
