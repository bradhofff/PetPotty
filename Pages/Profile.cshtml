@page
@model PetPotty.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

@if (TempData["ProfileStatus"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ProfileStatus"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["HouseholdError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["HouseholdError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
    </div>
}

<style>
    .profile-sidebar {
        min-width: 180px;
        border-right: 2px solid var(--pet-secondary, #f4a460);
        padding-right: 0;
    }

    .profile-sidebar .nav-link {
        color: var(--pet-dark, #3b1f0a);
        border-radius: 8px 0 0 8px;
        padding: 10px 20px;
        font-weight: 500;
        transition: background 0.15s ease;
    }

    .profile-sidebar .nav-link:hover {
        background: rgba(244, 164, 96, 0.15);
        color: var(--pet-primary, #c8762a);
    }

    .profile-sidebar .nav-link.active {
        background: rgba(244, 164, 96, 0.25);
        color: var(--pet-primary, #c8762a);
        border-right: 3px solid var(--pet-primary, #c8762a);
        font-weight: 700;
    }

    .profile-content {
        flex: 1;
        padding-left: 2rem;
    }

    .profile-field-row label {
        font-weight: 600;
        color: var(--pet-dark, #3b1f0a);
        min-width: 110px;
    }

    .field-display {
        color: #444;
        font-size: 1rem;
        padding: 6px 0;
    }
</style>

<h1 class="mb-4">👤 My Profile</h1>

<div class="d-flex align-items-start">

    @* ── LEFT SIDEBAR TAB BAR ─────────────────────────────────── *@
    <nav class="profile-sidebar me-0 d-flex flex-column nav" id="profileTabs">
        <a class="nav-link active" href="#account-details">
            👤 Profile
        </a>
        <a class="nav-link" href="#household-settings">
            🏠 Household
        </a>
        @* Future tabs — uncomment when ready:
        <a class="nav-link" href="/Profile">
            🔒 Security
        </a>
        *@
    </nav>

    @* ── MAIN CONTENT AREA ───────────────────────────────────── *@
    <div class="profile-content">

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* ─── PROFILE TAB ──────────────────────────────────────── *@
        <div class="card profile-card" id="account-details" style="border: 2px solid var(--pet-secondary); border-radius: 12px; max-width: 760px;">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background: rgba(244,164,96,0.12); border-bottom: 1px solid rgba(244,164,96,0.4);">
                <h5 class="mb-0">Account Details</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="editToggleBtn"
                        onclick="enableEditing()">
                    ✏️ Edit
                </button>
            </div>

            <form method="post" asp-page-handler="UpdateProfile" id="profileForm">
                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label fw-semibold">Name <span class="required-marker" aria-hidden="true">*</span></label>
                            <input asp-for="ProfileName" class="form-control profile-input"
                                   id="fieldName" required disabled />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Username <span class="required-marker" aria-hidden="true">*</span></label>
                            <input asp-for="ProfileUserName" class="form-control profile-input"
                                   id="fieldUserName" required disabled />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Email <span class="required-marker" aria-hidden="true">*</span></label>
                            <input asp-for="ProfileEmail" type="email" class="form-control profile-input"
                                   id="fieldEmail" required disabled />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Phone</label>
                            <input asp-for="ProfilePhone" type="tel" class="form-control profile-input"
                                   id="fieldPhone" disabled />
                        </div>

                    </div>

                    @* ─── PASSWORD CHANGE (hidden until editing) ───── *@
                    <div id="passwordSection" class="mt-4 d-none">
                        <hr style="border-color: rgba(244,164,96,0.4);" />
                        <h6 class="fw-semibold mb-3">Change Password <span class="text-muted fw-normal">(optional)</span></h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Current Password</label>
                                <input asp-for="CurrentPassword" type="password" class="form-control"
                                       placeholder="Enter current password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">New Password</label>
                                <input asp-for="NewPassword" type="password" class="form-control"
                                       placeholder="New password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Confirm New Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control"
                                       placeholder="Repeat new password" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-footer d-none" id="saveFooter"
                     style="background: transparent; border-top: 1px solid rgba(244,164,96,0.4);">
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="cancelEditing()">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            💾 Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <section class="mt-5" id="household-settings" aria-labelledby="household-heading">
            <div class="d-flex align-items-end justify-content-between gap-3 flex-wrap mb-3">
                <div>
                    <p class="app-eyebrow mb-1">SHARED CARE</p>
                    <h2 class="h3 mb-1" id="household-heading">Household</h2>
                    <p class="text-muted mb-0">Care for the same pets from separate PetPotty accounts.</p>
                </div>
                @if (Model.UserHouseholds.Count > 1)
                {
                    <form method="post" asp-page-handler="SwitchHousehold" class="household-switcher">
                        <label for="householdPublicID" class="form-label small fw-semibold">Current household</label>
                        <select id="householdPublicID" name="householdPublicID" class="form-select" onchange="this.form.submit()">
                            @foreach (var household in Model.UserHouseholds)
                            {
                                <option value="@household.PublicID" selected="@(household.HouseholdID == Model.ActiveHousehold?.HouseholdID)">@household.Name</option>
                            }
                        </select>
                    </form>
                }
            </div>

            @if (Model.ActiveHousehold != null)
            {
                <div class="card household-card mb-4">
                    <div class="card-body d-flex align-items-center justify-content-between gap-3 flex-wrap">
                        <div>
                            <h3 class="h5 mb-1">@Model.ActiveHousehold.Name</h3>
                            <span class="badge household-role-badge">Your role: @Model.ActiveHousehold.Role</span>
                        </div>
                        @if (Model.IsOwner)
                        {
                            <form method="post" asp-page-handler="RenameHousehold" class="d-flex gap-2 flex-wrap">
                                <label for="HouseholdName" class="visually-hidden">Household name</label>
                                <input asp-for="HouseholdName" class="form-control" maxlength="150" required />
                                <button type="submit" class="btn btn-outline-secondary">Rename</button>
                            </form>
                        }
                    </div>
                </div>

                <div class="card household-card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <div>
                            <h3 class="h5 mb-1">Members</h3>
                            <p class="text-muted small mb-0">Everyone uses their own login.</p>
                        </div>
                        @if (Model.IsOwner)
                        {
                            <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#inviteMemberForm" aria-expanded="false" aria-controls="inviteMemberForm">+ Invite Household Member</button>
                        }
                    </div>
                    @if (Model.IsOwner)
                    {
                        <div class="collapse" id="inviteMemberForm">
                            <div class="card-body border-bottom">
                                @if (!Model.EmailConfigured)
                                {
                                    <div class="alert alert-warning small">Invitations can be created, but email delivery requires the Email and App:BaseUrl settings.</div>
                                }
                                <form method="post" asp-page-handler="Invite" class="row g-3 align-items-end">
                                    <div class="col-md-7">
                                        <label asp-for="InviteEmail" class="form-label">Email address</label>
                                        <input asp-for="InviteEmail" type="email" class="form-control" maxlength="100" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="InviteRole" class="form-label">Role</label>
                                        <select asp-for="InviteRole" class="form-select">
                                            <option value="Member">Member</option>
                                            <option value="Caregiver">Caregiver</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 d-grid">
                                        <button type="submit" class="btn btn-primary">Send</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                    <div class="list-group list-group-flush household-member-list">
                        @foreach (var member in Model.Members)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                <div>
                                    <strong>@member.Name</strong>
                                    @if (member.IsCurrentUser)
                                    {
                                        <span class="text-muted small">(you)</span>
                                    }
                                    @if (Model.IsOwner)
                                    {
                                        <div><a href="mailto:@member.Email" class="small">@member.Email</a></div>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (Model.IsOwner && member.Role != PetPotty.Models.HouseholdRole.Owner)
                                    {
                                        <form method="post" asp-page-handler="ChangeMemberRole" class="d-flex gap-2">
                                            <input type="hidden" name="memberPublicID" value="@member.UserPublicID" />
                                            <select name="role" class="form-select form-select-sm" aria-label="Role for @member.Name">
                                                <option value="Member" selected="@(member.Role == PetPotty.Models.HouseholdRole.Member)">Member</option>
                                                <option value="Caregiver" selected="@(member.Role == PetPotty.Models.HouseholdRole.Caregiver)">Caregiver</option>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                        </form>
                                        <form method="post" asp-page-handler="RemoveMember">
                                            <input type="hidden" name="memberPublicID" value="@member.UserPublicID" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this member from the household? They will immediately lose access to its pets and records.');">Remove</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light household-member-role">@member.Role</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (Model.IsOwner)
                {
                    <div class="card household-card">
                        <div class="card-header">
                            <h3 class="h5 mb-1">Pending Invitations</h3>
                            <p class="text-muted small mb-0">Invitation links expire automatically.</p>
                        </div>
                        <div class="list-group list-group-flush household-member-list">
                            @if (Model.PendingInvitations.Count == 0)
                            {
                                <div class="list-group-item text-muted">No pending invitations.</div>
                            }
                            @foreach (var invitation in Model.PendingInvitations)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                    <div>
                                        <a href="mailto:@invitation.Email"><strong>@invitation.Email</strong></a>
                                        <div class="small text-muted">@invitation.Role · invited @invitation.CreatedAtUtc.ToString("MMM d") · expires @invitation.ExpiresAtUtc.ToString("MMM d") · Pending</div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <form method="post" asp-page-handler="ResendInvitation">
                                            <input type="hidden" name="invitationPublicID" value="@invitation.PublicID" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Resend</button>
                                        </form>
                                        <form method="post" asp-page-handler="CancelInvitation">
                                            <input type="hidden" name="invitationPublicID" value="@invitation.PublicID" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this household invitation?');">Cancel</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </section>

    </div>
</div>

@section Scripts {
    <script>
        // Store original values so Cancel can restore them
        const originalValues = {};

        function enableEditing() {
            const inputs = document.querySelectorAll('.profile-input');
            inputs.forEach(input => {
                originalValues[input.id] = input.value;
                input.disabled = false;
            });

            document.getElementById('editToggleBtn').classList.add('d-none');
            document.getElementById('saveFooter').classList.remove('d-none');
            document.getElementById('passwordSection').classList.remove('d-none');
            document.getElementById('fieldName').focus();
        }

        function cancelEditing() {
            const inputs = document.querySelectorAll('.profile-input');
            inputs.forEach(input => {
                input.value = originalValues[input.id] ?? input.value;
                input.disabled = true;
            });

            // Clear password fields
            document.querySelectorAll('#profileForm input[type="password"]')
                .forEach(f => f.value = '');

            document.getElementById('editToggleBtn').classList.remove('d-none');
            document.getElementById('saveFooter').classList.add('d-none');
            document.getElementById('passwordSection').classList.add('d-none');
        }

        // If page loaded with an error, re-enable editing automatically
        @if (Model.ErrorMessage != null)
        {
            <text>enableEditing();</text>
        }
    </script>
}
