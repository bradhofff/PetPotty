@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="simple-auth-page">
    <div class="auth-shell">
        <aside class="auth-brand-panel" aria-label="About PackTracker">
            <a asp-page="/Index" class="auth-wordmark"><span class="auth-mark" aria-hidden="true">🐾</span> PackTracker</a>
            <div class="auth-brand-copy">
                <span class="auth-eyebrow">A little more care, every day</span>
                <h1>Welcome back to your pack.</h1>
                <p>Keep the little things in one place, so you can spend more time on the moments that matter.</p>
                <div class="auth-feature-list" aria-hidden="true">
                    <div><span>✓</span> Stay on top of daily routines</div>
                    <div><span>✓</span> Keep health details close</div>
                    <div><span>✓</span> Care together with your household</div>
                </div>
            </div>
            <p class="auth-brand-footer">One happy home for every pet in your care.</p>
        </aside>
        <div class="auth-form-panel">
            <div class="auth-form-wrap">
                <div class="auth-form-heading">
                    <span class="auth-form-eyebrow">YOUR ACCOUNT</span>
                    <h2>Log in</h2>
                    <p>Good to see you again. Enter your details below.</p>
                </div>

                @if (TempData["LogoutMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert"><strong>@TempData["LogoutMessage"]</strong><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button></div>
                }
                @if (TempData["SignupSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert"><strong>@TempData["SignupSuccess"]</strong><br />Please log in to continue.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button></div>
                }

                <form method="post">
                    <input asp-for="InvitationToken" type="hidden" />
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                    }
                    <div class="auth-field">
                        <label asp-for="Username" class="form-label">Username <span class="required-marker" aria-hidden="true">*</span></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" placeholder="Your username" required aria-required="true" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="Password" class="form-label">Password <span class="required-marker" aria-hidden="true">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="Your password" required aria-required="true" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn auth-primary-btn w-100">Log in <span aria-hidden="true">→</span></button>
                </form>
                <p class="auth-switch">New to PackTracker? <a asp-page="/Signup" asp-route-invitationToken="@Model.InvitationToken">Create an account</a></p>
                <a asp-page="/Index" class="auth-back-link">← Back to home</a>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
