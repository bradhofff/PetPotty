@model PetPotty.Pages.ProfileModel

<section class="household-settings" aria-labelledby="household-heading">
    <div class="d-flex align-items-end justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <p class="app-eyebrow mb-1">SHARED CARE</p>
            <h2 class="h3 mb-1" id="household-heading">Household</h2>
            <p class="text-muted mb-0">Changes here affect the people and pets shared by @(Model.ActiveHousehold?.Name).</p>
        </div>
        @if (Model.UserHouseholds.Count > 1)
        {
            <form method="post" asp-page-handler="SwitchHousehold" class="household-switcher">
                <label for="householdPublicID" class="form-label small fw-semibold">Current household</label>
                <select id="householdPublicID" name="householdPublicID" class="form-select" onchange="this.form.submit()">
                    @foreach (var household in Model.UserHouseholds)
                    {
                        <option value="@household.PublicID" selected="@(household.HouseholdID == Model.ActiveHousehold?.HouseholdID)">@household.Name</option>
                    }
                </select>
            </form>
        }
    </div>

    @if (Model.ActiveHousehold != null)
    {
        <div class="card household-card mb-4">
            <div class="card-body d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div>
                    <h3 class="h5 mb-1">@Model.ActiveHousehold.Name</h3>
                    <span class="badge household-role-badge">Your role: @Model.ActiveHousehold.Role</span>
                </div>
                @if (Model.IsOwner)
                {
                    <form method="post" asp-page-handler="RenameHousehold" class="d-flex gap-2 flex-wrap">
                        <label for="HouseholdName" class="visually-hidden">Household name</label>
                        <input asp-for="HouseholdName" class="form-control" maxlength="150" required />
                        <button type="submit" class="btn btn-outline-secondary">Rename</button>
                    </form>
                }
            </div>
        </div>

        <div class="card household-card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div>
                    <h3 class="h5 mb-1">Members</h3>
                    <p class="text-muted small mb-0">Everyone uses their own login.</p>
                </div>
                @if (Model.IsOwner)
                {
                    <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#inviteMemberForm" aria-expanded="false" aria-controls="inviteMemberForm">+ Invite Household Member</button>
                }
            </div>
            @if (Model.IsOwner)
            {
                <div class="collapse" id="inviteMemberForm">
                    <div class="card-body border-bottom">
                        @if (!Model.EmailConfigured)
                        {
                            <div class="alert alert-warning small">Invitations can be created, but email delivery requires the Email and App:BaseUrl settings.</div>
                        }
                        <form method="post" asp-page-handler="Invite" class="row g-3 align-items-end">
                            <div class="col-md-7">
                                <label asp-for="InviteEmail" class="form-label">Email address</label>
                                <input asp-for="InviteEmail" type="email" class="form-control" maxlength="100" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="InviteRole" class="form-label">Role</label>
                                <select asp-for="InviteRole" class="form-select">
                                    <option value="Member">Member</option>
                                    <option value="Caregiver">Caregiver</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-grid">
                                <button type="submit" class="btn btn-primary">Send</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            <div class="list-group list-group-flush household-member-list">
                @foreach (var member in Model.Members)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <div>
                            <strong>@member.Name</strong>
                            @if (member.IsCurrentUser)
                            {
                                <span class="text-muted small">(you)</span>
                            }
                            @if (Model.IsOwner)
                            {
                                <div><a href="mailto:@member.Email" class="small">@member.Email</a></div>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (Model.IsOwner && member.Role != PetPotty.Models.HouseholdRole.Owner)
                            {
                                <form method="post" asp-page-handler="ChangeMemberRole" class="d-flex gap-2">
                                    <input type="hidden" name="memberPublicID" value="@member.UserPublicID" />
                                    <select name="role" class="form-select form-select-sm" aria-label="Role for @member.Name">
                                        <option value="Member" selected="@(member.Role == PetPotty.Models.HouseholdRole.Member)">Member</option>
                                        <option value="Caregiver" selected="@(member.Role == PetPotty.Models.HouseholdRole.Caregiver)">Caregiver</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                </form>
                                <form method="post" asp-page-handler="RemoveMember">
                                    <input type="hidden" name="memberPublicID" value="@member.UserPublicID" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this member from the household? They will immediately lose access to its pets and records.');">Remove</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge text-bg-light household-member-role">@member.Role</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.IsOwner)
        {
            <div class="card household-card">
                <div class="card-header">
                    <h3 class="h5 mb-1">Pending Invitations</h3>
                    <p class="text-muted small mb-0">Invitation links expire automatically.</p>
                </div>
                <div class="list-group list-group-flush household-member-list">
                    @if (Model.PendingInvitations.Count == 0)
                    {
                        <div class="list-group-item text-muted">No pending invitations.</div>
                    }
                    @foreach (var invitation in Model.PendingInvitations)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center gap-3 flex-wrap">
                            <div>
                                <a href="mailto:@invitation.Email"><strong>@invitation.Email</strong></a>
                                <div class="small text-muted">@invitation.Role · invited @invitation.CreatedAtUtc.ToString("MMM d") · expires @invitation.ExpiresAtUtc.ToString("MMM d") · Pending</div>
                            </div>
                            <div class="d-flex gap-2">
                                <form method="post" asp-page-handler="ResendInvitation">
                                    <input type="hidden" name="invitationPublicID" value="@invitation.PublicID" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Resend</button>
                                </form>
                                <form method="post" asp-page-handler="CancelInvitation">
                                    <input type="hidden" name="invitationPublicID" value="@invitation.PublicID" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this household invitation?');">Cancel</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</section>
