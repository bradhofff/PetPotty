    @* CONFIRM DOSE MODAL *@
    <div class="modal fade" id="confirmDoseModal" tabindex="-1" aria-labelledby="confirmDoseModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDoseModalLabel">Confirm Dose</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-page="/Medications" asp-page-handler="ConfirmSchedule">
                    <input type="hidden" name="medID" id="confirmDoseMedID" />
                    <input type="hidden" name="logDate" id="confirmDoseLogDate" />
                    <input type="hidden" name="utcOffsetMinutes" data-utc-offset />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="confirmDoseMedName" class="form-label fw-semibold">Medication</label>
                            <input type="text" class="form-control" id="confirmDoseMedName" readonly />
                        </div>
                        <div class="mb-3">
                            <label for="confirmDoseScheduledDisplay" class="form-label fw-semibold">Scheduled Dose</label>
                            <input type="text" class="form-control" id="confirmDoseScheduledDisplay" readonly />
                        </div>
                        <div>
                            <label for="confirmDoseConfirmedAt" class="form-label fw-semibold">
                                Confirmed Date & Time <span class="required-marker" aria-hidden="true">*</span>
                            </label>
                            <input type="datetime-local" name="confirmedAt" id="confirmDoseConfirmedAt"
                                   class="form-control" required />
                        </div>
                        <div class="mt-3"><label for="confirmDoseNotes" class="form-label fw-semibold">Notes (optional)</label><textarea name="notes" id="confirmDoseNotes" class="form-control" rows="2" maxlength="1000"></textarea></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Confirm Dose</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="recordDoseModal" tabindex="-1" aria-labelledby="recordDoseModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-page="/Medications" asp-page-handler="RecordDose" class="modal-content">
                <input type="hidden" name="medID" id="recordDoseMedID" />
                <input type="hidden" name="logDate" id="recordDoseLogDate" />
                <input type="hidden" name="utcOffsetMinutes" data-utc-offset />
                <div class="modal-header"><h5 class="modal-title" id="recordDoseModalLabel">Record dose outcome</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label for="recordDoseMedName" class="form-label fw-semibold">Medication</label><input id="recordDoseMedName" class="form-control" readonly /></div>
                    <div class="mb-3"><label for="recordDoseScheduledDisplay" class="form-label fw-semibold">Scheduled dose</label><input id="recordDoseScheduledDisplay" class="form-control" readonly /></div>
                    <div class="mb-3"><label for="recordDoseStatus" class="form-label fw-semibold">Outcome</label><select name="status" id="recordDoseStatus" class="form-select" required><option value="Skipped">Skipped</option><option value="Missed">Missed</option></select></div>
                    <div class="mb-3"><label for="recordDoseReason" class="form-label fw-semibold">Reason <span class="required-marker">*</span></label><input name="reason" id="recordDoseReason" class="form-control" maxlength="500" required placeholder="For example: pet refused it" /></div>
                    <div><label for="recordDoseNotes" class="form-label fw-semibold">Notes (optional)</label><textarea name="notes" id="recordDoseNotes" class="form-control" rows="2" maxlength="1000"></textarea></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save outcome</button></div>
            </form>
        </div>
    </div>
