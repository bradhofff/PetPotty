@model PetPotty.Models.HealthEvent
@{
    var offsetMinutes = ViewData["UtcOffsetMinutes"] as int? ?? 0;
    var occurredLocal = Model.OccurredAtUtc.AddMinutes(-offsetMinutes);
}

<div class="health-event-card kind-@Model.EventKind.ToLowerInvariant()" id="health-event-@Model.HealthEventID">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <strong>@Model.EventType</strong>
            @if (Model.Severity.HasValue)
            {
                <span class="text-muted small">
                    @for (int i = 0; i < Model.Severity.Value; i++) { <span class="health-severity-dot"></span> }
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.RecoveryStatus))
            {
                <span class="badge bg-secondary ms-1">@Model.RecoveryStatus</span>
            }
            <div class="text-muted small">@occurredLocal.ToString("MMM d, yyyy h:mm tt")</div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="mb-1 mt-1">@Model.Description</p>
            }
            <span class="health-attribution">Recorded by @(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "Recorded user unavailable" : Model.CreatedByName)</span>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary" asp-page="/Health" asp-page-handler="EditHealthEvent" asp-route-healthEventID="@Model.HealthEventID">Edit</a>
            <form method="post" asp-page-handler="DeleteHealthEvent" onsubmit="return confirm('Delete this record? This cannot be undone.');">
                <input type="hidden" name="healthEventID" value="@Model.HealthEventID" />
                <input type="hidden" name="petID" value="@Model.PetID" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </div>
    </div>
</div>
