@model PetPotty.Pages.HealthModel
@using PetPotty.Models
@if (Model.PetID.HasValue && Model.CanManageCarePlans && Model.CareError == null) {
    @foreach (var section in new[] { "Important", "Routine", "Contacts" }) {
        <div class="modal fade" id="care-edit-@(section)" tabindex="-1" aria-labelledby="care-title-@(section)" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable"><div class="modal-content">
                <div class="modal-header"><h2 class="modal-title fs-5" id="care-title-@(section)">@PetCareProfile.SectionTitle(section)</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <form method="post" asp-page="/Health" asp-page-handler="SaveCare" class="care-edit-form" data-section="@(section)">
                    <input type="hidden" name="petID" value="@Model.PetID" /><input type="hidden" name="section" value="@(section)" />
                    <div class="modal-body">
                        <p class="small text-muted">Optional plain-text information. Leave blank for “Not recorded”; enter “None known” only when that is what you mean.</p>
                        <div class="care-form-error text-danger" role="alert" tabindex="-1"></div>
                        @foreach (var field in PetCareProfile.Fields.Where(f => f.Section == section)) {
                            <div class="mb-3"><label class="form-label" for="care-@field.Name">@field.Label</label>
                            <textarea class="form-control" id="care-@field.Name" name="CareValues[@field.Name]" data-field="@field.Name" data-label="@field.Label" rows="@(field.Limit > 500 ? 3 : 1)" maxlength="@field.Limit" aria-describedby="care-error-@field.Name">@Model.CareProfile[field.Name]</textarea>
                            <div id="care-error-@field.Name" class="text-danger small" data-error-for="@field.Name"></div></div>
                        }
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save changes</button></div>
                </form>
            </div></div>
        </div>
    }
}
