@page
@model PetPotty.Pages.BillingModel
@using PetPotty.Billing
@{
    ViewData["Title"] = "Household billing";
    var current = Model.Current;
}
<div class="container py-4" style="max-width: 960px">
    <a asp-page="/Profile" asp-fragment="household-settings">&larr; Household settings</a>
    <h1 class="mt-3">Household billing</h1>
    <p class="text-muted">@Model.Household?.Name</p>
    @if (!string.IsNullOrEmpty(Model.BillingMessage))
    {
        <div class="alert alert-info" role="status">@Model.BillingMessage</div>
    }
    <section class="card mb-4" aria-labelledby="current-plan-heading">
        <div class="card-body">
            <h2 id="current-plan-heading" class="h4">Current plan: @current.Plan</h2>
            <p><strong>Status:</strong> @current.Status</p>
            @if (current.Plan == BillingPlan.Lifetime)
            {
                <p>Lifetime access. No renewal or expiration date.</p>
            }
            else if (current.AccessEndsAt.HasValue)
            {
                <p><strong>@(current.Plan == BillingPlan.Free ? "Paid access ended:" : "Paid access ends:")</strong> @current.AccessEndsAt.Value.ToString("MMM d, yyyy 'at' HH:mm 'UTC'")</p>
                @if (current.RenewsAt.HasValue)
                {
                    <p><strong>Next renewal:</strong> @current.RenewsAt.Value.ToString("MMM d, yyyy 'at' HH:mm 'UTC'")</p>
                }
            }
            else
            {
                <p>This household is on Free. No current paid access.</p>
            }
            @if (Model.IsOwner && Model.Account.CustomerId != null && Model.Configured)
            {
                <form method="post" asp-page-handler="Portal">
                    <input type="hidden" name="householdPublicId" value="@Model.Household?.PublicID" />
                    <button class="btn btn-outline-primary" type="submit">Manage billing</button>
                </form>
            }
        </div>
    </section>
    @if (!Model.IsOwner)
    {
        <p>Only a household owner can start or manage billing.</p>
    }
    else if (!Model.Configured)
    {
        <div class="alert alert-secondary">Billing is not available yet. Your current plan is shown above.</div>
    }
    else if (current.Plan == BillingPlan.Free)
    {
        <h2 class="h4">Choose a plan</h2>
        <div class="row g-3">
            @foreach (var plan in new[] { BillingPlan.Monthly, BillingPlan.Yearly, BillingPlan.Lifetime })
            {
                <div class="col-md-4">
                    <div class="card h-100"><div class="card-body">
                        <h3 class="h5">@plan</h3>
                        <p>@Model.PriceLabel(plan) @(plan == BillingPlan.Monthly ? "per month" : plan == BillingPlan.Yearly ? "per year" : "one-time payment")</p>
                        <p class="small text-muted">@(plan == BillingPlan.Lifetime ? "Pay once for lifetime household access." : "Renews automatically. Manage cancellation in billing.")</p>
                        <form method="post" asp-page-handler="Checkout">
                            <input type="hidden" name="householdPublicId" value="@Model.Household?.PublicID" />
                            <input type="hidden" name="plan" value="@plan" />
                            <button type="submit" class="btn btn-primary">Choose @plan</button>
                        </form>
                    </div></div>
                </div>
            }
        </div>
        <p class="small text-muted mt-3">Stripe shows the final price before payment. Paid access begins after payment confirmation.</p>
    }
    <a asp-page="/Billing" class="btn btn-link mt-3">Refresh billing status</a>
</div>
