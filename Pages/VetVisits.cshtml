                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success submit-once">Mark completed</button></div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="documentModal" tabindex="-1" aria-labelledby="documentLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="UploadDocument" enctype="multipart/form-data">
                    <input asp-for="DocumentVisitID" type="hidden" id="documentVisitID" />
                    <div class="modal-header"><div><h2 class="modal-title fs-5" id="documentLabel">Attach receipt or document</h2><div class="small opacity-75" id="documentContext"></div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="DocumentUpload" class="form-label">File <span class="required-marker" aria-hidden="true">*</span></label>
                            <input asp-for="DocumentUpload" id="documentUpload" type="file" class="visually-hidden vet-document-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" data-file-name-target="documentFileName" required />
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <label for="documentUpload" class="btn btn-outline-primary mb-0">Insert file</label>
                                <span id="documentFileName" class="small text-muted" aria-live="polite">No file selected</span>
                            </div>
                            <div class="form-text">Upload a receipt, invoice, care instructions, or another record. Word, PDF, JPEG, or PNG; maximum 10 MB.</div>
                            <span asp-validation-for="DocumentUpload" class="text-danger small"></span>
                        </div>
                        <div class="mb-3"><label asp-for="DocumentType" class="form-label">Document type <span class="required-marker" aria-hidden="true">*</span></label><select asp-for="DocumentType" class="form-select">@foreach (var type in PetPotty.Pages.VetVisitsModel.DocumentTypes) { <option>@type</option> }</select></div>
                        <div class="mb-3"><label asp-for="DocumentDisplayName" class="form-label">Display name</label><input asp-for="DocumentDisplayName" class="form-control" maxlength="260" placeholder="Defaults to the file name" /></div>
                        <div><label asp-for="DocumentDescription" class="form-label">Description</label><textarea asp-for="DocumentDescription" class="form-control" rows="2" maxlength="1000"></textarea></div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary submit-once">Upload</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editDocumentModal" tabindex="-1" aria-labelledby="editDocumentLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="UpdateDocument" id="editDocumentForm">
                    <input type="hidden" name="documentID" id="editDocumentID" />
                    <div class="modal-header"><h2 class="modal-title fs-5" id="editDocumentLabel">Edit attachment details</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <div class="mb-3"><label for="editDocumentType" class="form-label">Attachment type</label><select name="documentType" id="editDocumentType" class="form-select">@foreach (var type in PetPotty.Pages.VetVisitsModel.DocumentTypes) { <option>@type</option> }</select></div>
                        <div class="mb-3"><label for="editDocumentName" class="form-label">Display name <span class="required-marker" aria-hidden="true">*</span></label><input name="displayName" id="editDocumentName" class="form-control" maxlength="260" required /></div>
                        <div><label for="editDocumentDescription" class="form-label">Description</label><textarea name="description" id="editDocumentDescription" class="form-control" rows="2" maxlength="1000"></textarea></div>
                    </div>
                </form>
                <form method="post" asp-page-handler="DeleteDocument" id="deleteDocumentForm">
                    <input type="hidden" name="documentID" id="deleteDocumentID" />
                </form>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="submit" form="deleteDocumentForm" class="btn btn-danger"
                            onclick="return confirm('Delete this attachment and its stored file?');">Delete attachment</button>
                    <div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" form="editDocumentForm" class="btn btn-warning submit-once">Save changes</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function syncReminderFields(select) {
            const wrapper = select.closest('.row').querySelector('.custom-reminder-wrap');
            if (wrapper) wrapper.classList.toggle('d-none', select.value !== 'Custom');
        }

        function syncAllDay(checkbox) {
            const section = checkbox.closest('.vet-form-section');
            const input = section?.querySelector('.visit-time-input');
            if (!input) return;
            input.disabled = checkbox.checked;
            if (checkbox.checked) input.value = '';
        }

        function getClinicFields(select) {
            return {
                clinic: document.getElementById(select.dataset.clinicId),
                veterinarian: document.getElementById(select.dataset.veterinarianId)
            };
        }

        function applyClinicSelection(select, fillValues = true, clearNewValues = true) {
            const fields = getClinicFields(select);
            const option = select.selectedOptions[0];
            const isNew = select.value === '__new__';
            const isExisting = select.value !== '' && !isNew;
            const details = document.getElementById(select.dataset.detailsId);

            details.hidden = !isNew;
            Object.values(fields).forEach(field => {
                field.disabled = select.value === '';
                field.readOnly = !isNew;
            });
            if (isExisting && fillValues) {
                fields.clinic.value = option.dataset.clinic || option.value;
                fields.veterinarian.value = option.dataset.veterinarian || '';
            } else if ((isNew || select.value === '') && clearNewValues) {
                Object.values(fields).forEach(field => field.value = '');
            }

            if (isNew && clearNewValues)
                fields.clinic.focus();
        }

        function initializeClinicSelector(select) {
            const fields = getClinicFields(select);
            if (select.value) {
                applyClinicSelection(select, false, false);
                return;
            }
            const clinicName = fields.clinic.value.trim();
            const matchingOption = Array.from(select.options).find(option =>
                option.value !== '' && option.value !== '__new__'
                && option.value.localeCompare(clinicName, undefined, { sensitivity: 'accent' }) === 0);

            select.value = matchingOption?.value || (clinicName ? '__new__' : '');
            applyClinicSelection(select, false, false);
        }

        document.querySelectorAll('.reminder-choice').forEach(select => {
            syncReminderFields(select);
            select.addEventListener('change', () => syncReminderFields(select));
        });
        document.querySelectorAll('.all-day-toggle').forEach(checkbox => {
            syncAllDay(checkbox);
            checkbox.addEventListener('change', () => syncAllDay(checkbox));
        });
        document.querySelectorAll('.clinic-selector').forEach(select => {
            initializeClinicSelector(select);
            select.addEventListener('change', () => applyClinicSelection(select));
        });

        document.querySelectorAll('.edit-visit-btn').forEach(button => {
            button.addEventListener('click', () => {
                const data = button.dataset;
                document.getElementById('editVisitID').value = data.id;
                document.getElementById('editPetID').value = data.petId;
                document.getElementById('editVisitDate').value = data.date;
                document.getElementById('editVisitTime').value = data.time;
                document.getElementById('editAllDay').checked = data.allDay === 'true';
                document.getElementById('editClinic').value = data.clinic;
                document.getElementById('editVeterinarian').value = data.veterinarian;
                document.getElementById('editVisitReason').value = data.reason;
                document.getElementById('editVisitType').value = data.type;
                document.getElementById('editVisitStatus').value = data.status;
                document.getElementById('editNotes').value = data.notes;
                document.getElementById('editFollowUp').value = data.followUp;
                document.getElementById('editCost').value = data.cost;
                document.getElementById('editEmergency').checked = data.emergency === 'true';
                document.getElementById('editClinicSelector').value = '';
                initializeClinicSelector(document.getElementById('editClinicSelector'));
                const editDocument = document.getElementById('editVisitDocumentUpload');
                editDocument.value = '';
                updateDocumentFileName(editDocument);
                document.getElementById('editReminderChoice').value = data.reminderAt ? 'Custom' : 'None';
                document.getElementById('editReminderAt').value = data.reminderAt;
                syncReminderFields(document.getElementById('editReminderChoice'));
                syncAllDay(document.getElementById('editAllDay'));
            });
        });

        document.querySelectorAll('.complete-visit-btn').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('completeVisitID').value = button.dataset.id;
                document.getElementById('completeVisitContext').textContent =
                    `${button.dataset.petName} · ${button.dataset.date}`;
                document.getElementById('completeFollowUp').value = button.dataset.followUp;
                document.getElementById('completeCost').value = button.dataset.cost;
            });
        });

        function updateDocumentFileName(input) {
            const target = document.getElementById(input.dataset.fileNameTarget);
            if (target) target.textContent = input.files?.[0]?.name || 'No file selected';
        }

        document.querySelectorAll('.vet-document-input').forEach(input => {
            input.addEventListener('change', () => updateDocumentFileName(input));
        });

        document.querySelectorAll('.upload-document-btn').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('documentVisitID').value = button.dataset.visitId;
                document.getElementById('documentContext').textContent = button.dataset.petName;
            });
        });

        document.querySelectorAll('.edit-document-btn').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('editDocumentID').value = button.dataset.id;
                document.getElementById('deleteDocumentID').value = button.dataset.id;
                document.getElementById('editDocumentType').value = button.dataset.type;
                document.getElementById('editDocumentName').value = button.dataset.name;
                document.getElementById('editDocumentDescription').value = button.dataset.description;
            });
        });

        const panelControlSelector = 'button, a, input, select, textarea, label, form';

        document.querySelectorAll('.visit-card-main').forEach(panel => {
            panel.addEventListener('click', event => {
                if (!(event.target instanceof Element)
                    || event.target.closest(panelControlSelector)) return;

                document.getElementById(panel.dataset.detailsButtonId)?.click();
            });
        });

        document.querySelectorAll('.document-row').forEach(row => {
            row.addEventListener('click', event => {
                if (!(event.target instanceof Element)
                    || event.target.closest(panelControlSelector)
                    || event.target.closest('.document-preview')) return;

                row.querySelector('.document-title')?.click();
            });
        });

        document.querySelectorAll('.document-preview-collapse').forEach(preview => {
            preview.addEventListener('show.bs.collapse', () => {
                preview.querySelectorAll('[data-preview-src]').forEach(element => {
                    if (!element.getAttribute('src'))
                        element.setAttribute('src', element.dataset.previewSrc);
                });
            });
        });

        function resetSubmitButton(button) {
            if (!button) return;
            button.disabled = false;
            if (button.dataset.idleHtml) button.innerHTML = button.dataset.idleHtml;
        }

        function getSubmitButton(form) {
            return form.querySelector('.submit-once')
                || (form.id ? document.querySelector(`.submit-once[form="${form.id}"]`) : null);
        }

        document.querySelectorAll('form').forEach(form => {
            const button = getSubmitButton(form);
            if (button) button.dataset.idleHtml = button.innerHTML;

            form.addEventListener('submit', event => {
                const button = getSubmitButton(form);
                if (!button) return;

                const nativeValid = form.checkValidity();
                const unobtrusiveValid = !window.jQuery
                    || !window.jQuery.validator
                    || window.jQuery(form).valid();
                if (!nativeValid || !unobtrusiveValid || event.defaultPrevented) {
                    resetSubmitButton(button);
                    return;
                }

                button.disabled = true;
                button.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving…';
            });

            form.addEventListener('invalid', () => resetSubmitButton(button), true);
        });

        window.addEventListener('pageshow', () => {
            document.querySelectorAll('.submit-once').forEach(resetSubmitButton);
        });

        const modalToOpen = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ModalToOpen));
        const openAddModal = @Model.OpenAddModal.ToString().ToLowerInvariant();
        if (modalToOpen) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById(modalToOpen)).show();
        } else if (openAddModal) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('addVisitModal')).show();
        }

        const focusedVisit = document.querySelector('.visit-focus');
        if (focusedVisit) {
            requestAnimationFrame(() => focusedVisit.scrollIntoView({ behavior: 'smooth', block: 'center' }));
        }
    </script>
}
